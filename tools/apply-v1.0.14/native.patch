+                    f.write(time.strftime("%Y-%m-%d %H:%M:%S")+" GUI heartbeat lost; restarting Studio Monitor\n")
+                if getattr(sys,"frozen",False):
+                    subprocess.Popen([sys.executable],cwd=str(BASE))
